# Set canvas display dimensions
options(repr.plot.width = 12, repr.plot.height = 8.5)

# Configure margins (expanded right margin for legend, left for y-axis)
par(mar = c(5, 7, 5, 11), family = "sans", xpd = TRUE)

# 1. Initialize Canvas
plot(0, type = "n", xlim = c(-1.3, 1.3), ylim = c(76, 94),
     axes = FALSE, xlab = "", ylab = "")

# 2. Y-Axis Setup (76 to 94, step 2)
y_ticks <- seq(76, 94, by = 2)
grid_col <- "#E0E0E0"

# Horizontal gridlines
for (y in y_ticks) {
  lines(c(-1.3, 1.3), c(y, y), col = grid_col, lwd = 1.2)
}

# Vertical gridlines for Factor A levels (-1, 0, +1)
x_grid <- c(-1, 0, 1)
for (x in x_grid) {
  lines(c(x, x), c(76, 94), col = grid_col, lwd = 1.2)
}

# Outer Frame
rect(-1.3, 76, 1.3, 94, border = "gray30", lwd = 1.5)

# Top Subpanel Header Banner (Minitab Style)
rect(-1.3, 92.4, 1.3, 94.0, col = "#E5E7EB", border = "gray30", lwd = 1.5)
text(0, 93.2, "A * B", cex = 2, font = 2, col = "#111827")

# 3. Y-Axis & X-Axis Ticks & Labels (cex = 2)
axis(2, at = y_ticks, labels = y_ticks, las = 1, cex.axis = 2, 
     col = "transparent", col.ticks = "gray30", lwd.ticks = 1.5)
mtext("Mean", side = 2, line = 4.2, cex = 2, font = 2)

axis(1, at = c(-1, 0, 1), labels = c("-1.0", "0.0", "1.0"), cex.axis = 2, 
     col = "transparent", col.ticks = "gray30", lwd.ticks = 1.5)

# 4. Interaction Series & Points
# B = -1 Series (Solid line with filled circles)
lines(c(-1, 1), c(87.1, 78.6), col = "black", lwd = 2, lty = 1)
points(c(-1, 1), c(87.1, 78.6), pch = 19, cex = 2.2, col = "black")

# B = +1 Series (Dashed line with filled diamonds)
lines(c(-1, 1), c(83.1, 84.6), col = "black", lwd = 2, lty = 2)
points(c(-1, 1), c(83.1, 84.6), pch = 18, cex = 2.2, col = "black")

# Center Point (Standalone point at X = 0, Y = 92.1)
points(0, 92.1, pch = 19, cex = 2.2, col = "black")

# 5. Titles (cex = 2)
mtext("Interaction Plot", side = 3, line = 2.6, cex = 2, font = 2)

