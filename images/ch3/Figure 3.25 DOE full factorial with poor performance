# Set canvas display dimensions
options(repr.plot.width = 12, repr.plot.height = 8.5)

# Configure margins (expanded bottom margin for factor levels/labels, right margin for legend)
par(mar = c(6, 7, 5, 10), family = "sans", xpd = TRUE)

# 1. Initialize Canvas
plot(0, type = "n", xlim = c(0.5, 2.5), ylim = c(78, 94),
     axes = FALSE, xlab = "", ylab = "")

# 2. Y-Axis Setup (80 to 94, step 2)
y_ticks <- seq(80, 94, by = 2)
grid_col <- "#E0E0E0"

# Horizontal gridlines
for (y in y_ticks) {
  lines(c(0.5, 2.5), c(y, y), col = grid_col, lwd = 1.2)
}

# Vertical gridlines for subpanels
x_grid <- c(0.7, 1.0, 1.3, 1.7, 2.0, 2.3)
for (x in x_grid) {
  lines(c(x, x), c(78, 94), col = grid_col, lwd = 1.2)
}

# Outer Frame & Center Panel Divider Line
rect(0.5, 78, 2.5, 94, border = "gray30", lwd = 1.5)
lines(c(1.5, 1.5), c(78, 94), col = "gray30", lwd = 1.5)

# 3. Y-Axis Ticks & Labeling (cex = 2)
axis(2, at = y_ticks, labels = y_ticks, las = 1, cex.axis = 2, 
     col = "transparent", col.ticks = "gray30", lwd.ticks = 1.5)
mtext("Mean", side = 2, line = 4.2, cex = 2, font = 2)

# 4. X-Axis Factor Levels & Factor Names (cex = 2)
# Factor A (Left Panel)
text(0.7, 76.2, "-1", cex = 2)
text(1.3, 76.2, "1",  cex = 2)
text(1.0, 73.8, "A",  cex = 2, font = 2)

# Factor B (Right Panel)
text(1.7, 76.2, "-1", cex = 2)
text(2.3, 76.2, "1",  cex = 2)
text(2.0, 73.8, "B",  cex = 2, font = 2)

# 5. Data Points & Factor Lines (Calculated Means from Dataset)
# Panel 1 (Factor A: Mean at -1 = 85.15, Mean at 1 = 81.60, Center Mean = 92.10)
x_p1 <- c(0.7, 1.3)
y_p1 <- c(85.15, 81.60)
lines(x_p1, y_p1, col = "black", lwd = 2)
points(x_p1, y_p1, pch = 15, cex = 2, col = "black") # Corner points
points(1.0, 92.10, pch = 15, cex = 2, col = "black") # Center point

# Panel 2 (Factor B: Mean at -1 = 82.85, Mean at 1 = 83.85, Center Mean = 92.10)
x_p2 <- c(1.7, 2.3)
y_p2 <- c(82.85, 83.85)
lines(x_p2, y_p2, col = "black", lwd = 2)
points(x_p2, y_p2, pch = 15, cex = 2, col = "black") # Corner points
points(2.0, 92.10, pch = 15, cex = 2, col = "black") # Center point

# 6. Titles (cex = 2)
mtext("Main Effects Plot", side = 3, line = 2.6, cex = 2, font = 2)


