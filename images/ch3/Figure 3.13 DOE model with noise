# Set canvas display dimensions
options(repr.plot.width = 10, repr.plot.height = 9)

# Configure margins
par(mar = c(1, 1, 1, 1), family = "sans")

# 1. Initialize Blank Canvas
plot(0, type = "n", xlim = c(0, 7), ylim = c(0, 10),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Draw Top Section: Regression Equation Box
rect(0.3, 6.3, 6.7, 9.5, col = "#F3F4F6", border = "#DC2626", lwd = 2.5)

# Text inside regression equation box (cex = 2)
text(3.5, 8.3, "Regression Equation in Uncoded Units", col = "#3B5998", font = 2, cex = 2)
text(3.5, 7.2, "C7   =   79.10 + 4.150 A + 2.800 B + 1.450 A*B", col = "#1F2937", font = 1, cex = 2)

# 3. Draw Bottom Section: Table without empty right columns
x_cols <- c(0.3, 1.5, 3.2, 4.9, 6.7)
y_rows <- c(5.5, 4.5, 3.5, 2.5, 1.5, 0.5)

# Table background
rect(0.3, 0.5, 6.7, 5.5, col = "#FFFFFF", border = "#D1D5DB", lwd = 1.5)

# Variable Header background (Grey fill for top header row)
rect(0.3, 4.5, 6.7, 5.5, col = "#E5E7EB", border = NA)

# Row Index column background (Grey fill for leftmost column)
rect(0.3, 0.5, 1.5, 4.5, col = "#E5E7EB", border = NA)

# Draw vertical gridlines
for (x in x_cols) {
  lines(c(x, x), c(0.5, 5.5), col = "#D1D5DB", lwd = 1.2)
}

# Draw horizontal gridlines
for (y in y_rows) {
  lines(c(0.3, 6.7), c(y, y), col = "#D1D5DB", lwd = 1.2)
}

# 4. Fill Header & Cell Content (All text & numbers cex = 2)

# Variable Names Header
text(2.35, 5.0, "A", font = 2, cex = 2, col = "#111827")
text(4.05, 5.0, "B", font = 2, cex = 2, col = "#111827")

# Row Index Numbers
text(0.9, 4.0, "1", font = 2, cex = 2, col = "#111827")
text(0.9, 3.0, "2", font = 2, cex = 2, col = "#111827")
text(0.9, 2.0, "3", font = 2, cex = 2, col = "#111827")
text(0.9, 1.0, "4", font = 2, cex = 2, col = "#111827")

# Data Grid Values
# Row 1: A = -1, B = -1, Y = 73.6
text(2.35, 4.0, "-1", cex = 2, col = "#111827")
text(4.05, 4.0, "-1", cex = 2, col = "#111827")
text(5.80, 4.0, "73.6", cex = 2, col = "#111827")

# Row 2: A = 1, B = -1, Y = 79.0
text(2.35, 3.0, "1", cex = 2, col = "#111827")
text(4.05, 3.0, "-1", cex = 2, col = "#111827")
text(5.80, 3.0, "79.0", cex = 2, col = "#111827")

# Row 3: A = -1, B = 1, Y = 76.3
text(2.35, 2.0, "-1", cex = 2, col = "#111827")
text(4.05, 2.0, "1", cex = 2, col = "#111827")
text(5.80, 2.0, "76.3", cex = 2, col = "#111827")

# Row 4: A = 1, B = 1, Y = 87.5
text(2.35, 1.0, "1", cex = 2, col = "#111827")
text(4.05, 1.0, "1", cex = 2, col = "#111827")
text(5.80, 1.0, "87.5", cex = 2, col = "#111827")

# 5. Outline Active Selection Box around Data
rect(1.5, 0.5, 6.7, 4.5, border = "#374151", lwd = 2.5)
