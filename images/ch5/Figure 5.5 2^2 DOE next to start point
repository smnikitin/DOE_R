# 1. Define dataset
doe_data <- data.frame(
  A = c(-0.7, -0.5, -0.7, -0.5),
  B = c(-0.8, -0.8, -0.6, -0.6),
  Response = c(64.575, 68.675, 69.575, 74.075)
)

# 2. Fit the linear model with interaction
model_ff <- lm(Response ~ A * B, data = doe_data)

# 3. Force a square canvas layout in Google Colab
options(repr.plot.width = 6, repr.plot.height = 6)

# 4. Generate grid using the exact min/max bounds of your data
a_seq <- seq(min(doe_data$A), max(doe_data$A), length.out = 50)
b_seq <- seq(min(doe_data$B), max(doe_data$B), length.out = 50)

grid_data <- expand.grid(A = a_seq, B = b_seq)
grid_data$Y_pred <- predict(model_ff, newdata = grid_data)
z_vals <- matrix(grid_data$Y_pred, nrow = length(a_seq), ncol = length(b_seq))

# 5. Render the Grayscale Contour Plot
filled.contour(a_seq, b_seq, z_vals,
               # Black=High (0), White=Low (0.9)
               color.palette = function(n) gray.colors(n, start = 0.9, end = 0),
               xlab = "Factor A",
               ylab = "Factor B",
               main = "Contour Plot of Y vs A and B", 
               nlevels = 6)
