# =====================================================================
# R Script for Google Colab: DOE Response Surface Demonstration
# =====================================================================

# Force a square, high-resolution plot canvas in Google Colab
options(repr.plot.width = 7, repr.plot.height = 7)

# 1. Define the Reduced Analytical Equation
# Y = 90 + 7.5A + 7.5B - 17.5A^2 - 17.5B^2 + 10AB
calc_Y <- function(A, B) {
  90 + 7.5*A + 7.5*B - 17.5*A^2 - 17.5*B^2 + 10*A*B
}

# 2. Calculate the Key Coordinates to prove the math live
max_val <- calc_Y(0.3, 0.3)
upper_corner <- calc_Y(1, 1)
lower_corner <- calc_Y(-1, -1)
mixed_corner <- calc_Y(-1, 1) # Same as (1, -1)

# 3. Print the formatted summary to the Colab console
cat("Full Model: Y = 90 + 7.5A + 7.5B + 0.5C + 0.2D + 0.4E + 0.3G - 17.5A² - 17.5B² + 10AB\n")
cat("Reduced Model: Y = 90 + 7.5A + 7.5B - 17.5A² - 17.5B² + 10AB\n")
cat("Design Space: [-1, 1]\n\n")

cat("Maximum (Stationary Point): (0.3, 0.3) -> 92.25\n")
cat("Upper Corner (1, 1): -> 80.00\n")
cat("Lower Corner (-1, -1): -> 50.00\n")
cat("Mixed Corners (-1, 1) and (1, -1): -> 45.00\n\n")

cat("Gradient A: ∂Y/∂A = 7.5 - 35A + 10B = 0\n")
cat("Gradient B: ∂Y/∂B = 7.5 - 35B + 10A = 0\n")
cat("Solution: A = 0.3, B = 0.3\n\n")

cat("Pure Curvature (A): ∂²Y/∂A² = -35\n")
cat("Pure Curvature (B): ∂²Y/∂B² = -35\n")
cat("Interaction (Twist): ∂²Y/(∂A∂B) = 10\n")

# =====================================================================
#  Generate the Visual Plot for the Textbook/Students
# =====================================================================

# Create the grid for the plot across the design space [-1, 1]
a_seq <- seq(-1, 1, length.out = 100)
b_seq <- seq(-1, 1, length.out = 100)
z_vals <- outer(a_seq, b_seq, calc_Y)

# Plot the Response Surface contour with cex = 1.5 for all text/numbers
filled.contour(a_seq, b_seq, z_vals,
               color.palette = function(n) hcl.colors(n, "YlOrRd", rev = TRUE),
               xlab = "Factor A ",
               ylab = "Factor B ",
               main = "Response Surface Optimization", 
               nlevels = 20,
               cex.lab = 1.5,   # Axis labels
               cex.axis = 1.5,  # Legend tick numbers
               cex.main = 1.5,  # Plot title
               plot.axes = {
                 axis(1, cex.axis = 1.5)  # X-axis numbers
                 axis(2, cex.axis = 1.5)  # Y-axis numbers
                 
                 # Overlay standard contour lines with cex = 1.5
                 contour(a_seq, b_seq, z_vals, add = TRUE, col = "black", lwd = 0.5, cex = 1.5)
                 
                 # Plot the Key Points (Max + Corners)
                 points(x = c(0.3, 1, -1, -1, 1), 
                        y = c(0.3, 1, -1, 1, -1), 
                        pch = 21, col = "black", bg = "cyan", cex = 1.5, lwd = 1.2)
                 
                 # Add text labels to the points (cex = 1.5)
                 text(0.3, 0.3, "Max (0.3, 0.3)", pos = 3, font = 2, cex = 1.5)
               })
