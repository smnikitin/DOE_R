# Expanded canvas size to accommodate large text without margin errors
options(repr.plot.width = 16, repr.plot.height = 9)

# Base parameters with expanded margins
par(mar = c(5, 7, 5, 9), xpd = TRUE, family = "sans", cex = 2)

# 1. Initialize Canvas
plot(0, type = "n", xlim = c(0, 20.5), ylim = c(0.5, 3.5),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Borders
box("figure", col = "black", lwd = 1.2)
box("plot", col = "gray50", lwd = 1)

# 3. Gridlines
abline(v = c(5, 10, 15, 20), col = "#E0E0E0", lwd = 1)
abline(h = c(1, 2, 3), col = "#E0E0E0", lwd = 1)

