# Expanded canvas size to accommodate large text without margin errors
options(repr.plot.width = 16, repr.plot.height = 9)

# Base parameters with expanded margins
par(mar = c(5, 7, 5, 9), xpd = TRUE, family = "sans", cex = 2)

# 1. Initialize Canvas
plot(0, type = "n", xlim = c(0, 20.5), ylim = c(0.5, 3.5),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Borders
box("figure", col = "black", lwd = 1.2)
box("plot", col = "gray50", lwd = 1)

# 3. Gridlines
abline(v = c(5, 10, 15, 20), col = "#E0E0E0", lwd = 1)
abline(h = c(1, 2, 3), col = "#E0E0E0", lwd = 1)

# 4. Horizontal Effect Bars (Minitab Blue)
rect(xleft = 0, ybottom = 2.5, xright = 2.0, ytop = 3.5, col = "#8DAEE0", border = "gray30", lwd = 1)
rect(xleft = 0, ybottom = 1.5, xright = 1.0, ytop = 2.5, col = "#8DAEE0", border = "gray30", lwd = 1)

# 6. Axes, Ticks, and Axis Labels
axis(2, at = c(1, 2, 3), labels = c("AB", "B", "A"), las = 1, tick = TRUE, col = "gray50", tck = -0.015, cex.axis = 2)
axis(1, at = seq(0, 20, 5), tick = TRUE, col = "gray50", tck = -0.015, cex.axis = 2)
mtext("Effect", side = 1, line = 3.2, cex = 2)
text(x = -3.2, y = 3.75, labels = "Term", font = 2, cex = 2, adj = 0)

# 7. Titles
mtext("Pareto Chart of the Effects", side = 3, line = 2.8, font = 1, cex = 2)
mtext("(response is C7, \u03b1 = 0.05)", side = 3, line = 0.8, col = "gray40", cex = 2)

