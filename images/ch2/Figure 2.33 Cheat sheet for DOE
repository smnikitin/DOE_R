# Set canvas display dimensions
options(repr.plot.width = 14, repr.plot.height = 10)

# Configure margins for larger text
par(mar = c(6, 8, 6, 2), xpd = TRUE, family = "sans")

# Define grid dimensions
runs <- c(4, 8, 16, 32, 64, 128)
k_cols <- 2:15
n_rows <- length(runs)
n_cols <- length(k_cols)

# Initialize data and type matrices
mat_txt <- matrix("", nrow = n_rows, ncol = n_cols)
mat_type <- matrix("white", nrow = n_rows, ncol = n_cols)

rownames(mat_txt) <- runs
colnames(mat_txt) <- k_cols
rownames(mat_type) <- runs
colnames(mat_type) <- k_cols

# Populate Row 4 (index 1)
mat_txt[1, "2"] <- "Full"; mat_type[1, "2"] <- "black"
mat_txt[1, "3"] <- "III";  mat_type[1, "3"] <- "light"

# Populate Row 8 (index 2)
mat_txt[2, "3"] <- "Full"; mat_type[2, "3"] <- "black"
mat_txt[2, "4"] <- "IV";   mat_type[2, "4"] <- "hatch"
for(c in 5:7) { mat_txt[2, as.character(c)] <- "III"; mat_type[2, as.character(c)] <- "light" }

# Populate Row 16 (index 3)
mat_txt[3, "4"] <- "Full"; mat_type[3, "4"] <- "black"
mat_txt[3, "5"] <- "V";    mat_type[3, "5"] <- "medium"
for(c in 6:8) { mat_txt[3, as.character(c)] <- "IV"; mat_type[3, as.character(c)] <- "hatch" }
for(c in 9:15) { mat_txt[3, as.character(c)] <- "III"; mat_type[3, as.character(c)] <- "light" }

# Populate Row 32 (index 4)
mat_txt[4, "5"] <- "Full"; mat_type[4, "5"] <- "black"
mat_txt[4, "6"] <- "VI";   mat_type[4, "6"] <- "dark"
for(c in 7:15) { mat_txt[4, as.character(c)] <- "IV"; mat_type[4, as.character(c)] <- "hatch" }

# Populate Row 64 (index 5)
mat_txt[5, "6"] <- "Full"; mat_type[5, "6"] <- "black"
mat_txt[5, "7"] <- "VII";  mat_type[5, "7"] <- "dark"
mat_txt[5, "8"] <- "V";    mat_type[5, "8"] <- "medium"
for(c in 9:15) { mat_txt[5, as.character(c)] <- "IV"; mat_type[5, as.character(c)] <- "hatch" }

# Populate Row 128 (index 6)
mat_txt[6, "7"] <- "Full"; mat_type[6, "7"] <- "black"
mat_txt[6, "8"] <- "VIII"; mat_type[6, "8"] <- "dark"
mat_txt[6, "9"] <- "VI";   mat_type[6, "9"] <- "dark"
mat_txt[6, "10"] <- "V";   mat_type[6, "10"] <- "medium"
mat_txt[6, "11"] <- "V";   mat_type[6, "11"] <- "medium"
for(c in 12:15) { mat_txt[6, as.character(c)] <- "IV"; mat_type[6, as.character(c)] <- "hatch" }

# Initialize plot canvas (y from 0 to n_rows, x from 0 to n_cols)
plot(0, type = "n", xlim = c(0, n_cols), ylim = c(0, n_rows),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# Draw cells with corresponding fills and borders
for (r in 1:n_rows) {
  for (c in 1:n_cols) {
    xleft   <- c - 1
    xright  <- c
    ybottom <- n_rows - r
    ytop    <- (n_rows - r) + 1
    
    t_val <- mat_type[r, c]
    
    # Background and hatch settings
    if (t_val == "white") {
      rect(xleft, ybottom, xright, ytop, col = "white", border = "#CBD5E1", lwd = 1)
    } else if (t_val == "light") {
      rect(xleft, ybottom, xright, ytop, col = "#E2E8F0", border = "#CBD5E1", lwd = 1)
    } else if (t_val == "hatch") {
      rect(xleft, ybottom, xright, ytop, col = "#94A3B8", border = "#CBD5E1", lwd = 1)
      rect(xleft, ybottom, xright, ytop, density = 15, angle = 45, col = "#64748B", border = NA)
    } else if (t_val == "medium") {
      rect(xleft, ybottom, xright, ytop, col = "#475569", border = "#CBD5E1", lwd = 1)
    } else if (t_val == "dark") {
      rect(xleft, ybottom, xright, ytop, col = "#334155", border = "#CBD5E1", lwd = 1)
    } else if (t_val == "black") {
      rect(xleft, ybottom, xright, ytop, col = "black", border = "black", lwd = 1)
    }
    
    # Add text label with cex = 2
    txt <- mat_txt[r, c]
    if (txt != "") {
      txt_col <- ifelse(t_val %in% c("black", "dark", "medium"), "white", "black")
      text(xleft + 0.5, ybottom + 0.5, labels = txt, col = txt_col, font = 2, cex = 2)
    }
  }
}

# Axis labels & Ticks with cex = 2
axis(3, at = (1:n_cols) - 0.5, labels = k_cols, tick = FALSE, cex.axis = 2, line = 0.5)
mtext("Factors", side = 3, line = 3.5, font = 2, cex = 2)

axis(2, at = (n_rows:1) - 0.5, labels = runs, las = 1, tick = FALSE, cex.axis = 2, line = 0.5)
mtext("Number of Runs", side = 2, line = 5.0, font = 2, cex = 2)
