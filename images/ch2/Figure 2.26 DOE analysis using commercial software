# Set inline display dimensions
options(repr.plot.width = 11, repr.plot.height = 6)

# Configure margins
par(mar = c(4.5, 5.5, 4.5, 2), xpd = TRUE, family = "sans")

# 1. Initialize Canvas (X domain split into 3 panels: 0-2 for A, 2-4 for B, 4-6 for C)
plot(0, type = "n", xlim = c(0, 6), ylim = c(85.8, 94.2),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Draw Background Gridlines
abline(h = 86:94, col = "#EBF0F5", lwd = 1)
abline(v = c(0.5, 1.5, 2.5, 3.5, 4.5, 5.5), col = "#EBF0F5", lwd = 1)

# 3. Draw Center Reference Line (Grand Mean ~ 89.75)
abline(h = 89.75, col = "gray60", lty = 2, lwd = 1)

# 4. Outer Borders and Panel Dividers
rect(0, 85.8, 6, 94.2, border = "gray50", lwd = 1.2)         # Outer border
segments(c(2, 4), 85.8, c(2, 4), 94.2, col = "gray50", lwd = 1.2) # Panel dividers
segments(0, 93.8, 6, 93.8, col = "gray50", lwd = 1.2)        # Header divider

# 5. Panel Headers
text(x = 1, y = 94.0, labels = "A", font = 1, cex = 2)
text(x = 3, y = 94.0, labels = "B", font = 1, cex = 2)
text(x = 5, y = 94.0, labels = "C", font = 1, cex = 2)

# 6. Plot Data Points and Lines (Minitab Blue)
blue_col <- "#3A75C4"

# Factor A (x = 0.5, 1.5)
lines(c(0.5, 1.5), c(88.2, 91.3), col = blue_col, lwd = 1.5)
points(c(0.5, 1.5), c(88.2, 91.3), pch = 16, col = blue_col, cex = 2)

# Factor B (x = 2.5, 3.5)
lines(c(2.5, 3.5), c(86.6, 92.9), col = blue_col, lwd = 1.5)
points(c(2.5, 3.5), c(86.6, 92.9), pch = 16, col = blue_col, cex = 2)

# Factor C (x = 4.5, 5.5)
lines(c(4.5, 5.5), c(93.3, 86.2), col = blue_col, lwd = 1.5)
points(c(4.5, 5.5), c(93.3, 86.2), pch = 16, col = blue_col, cex = 2)

# 7. Axes and Labels
# Y-axis
axis(2, at = 86:94, pos = 0, las = 1, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015, cex.axis = 2)
mtext("Mean", side = 2, line = 4, cex = 2, font = 3)

# X-axis ticks for each panel
axis(1, at = c(0.5, 1.5), labels = c("-1", "1"), pos = 85.8, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015, cex.axis = 2)
axis(1, at = c(2.5, 3.5), labels = c("-1", "1"), pos = 85.8, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015, cex.axis = 2)
axis(1, at = c(4.5, 5.5), labels = c("-1", "1"), pos = 85.8, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015, cex.axis = 2)

# 8. Titles
mtext("Main Effects Plot", side = 3, line = 2.2, font = 2, cex = 2)

