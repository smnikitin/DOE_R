# Set canvas display dimensions
options(repr.plot.width = 11, repr.plot.height = 7.5)

# Configure margins (extra right margin for stacked legends)
par(mar = c(5, 5.5, 4.5, 7.5), xpd = TRUE, family = "sans")

# 1. Initialize Canvas (3x3 grid matrix domain [0,3] x [0,3])
plot(0, type = "n", xlim = c(0, 3), ylim = c(0, 3),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Outer Border and 3x3 Grid Matrix Dividers
rect(0, 0, 3, 3, border = "gray50", lwd = 1.2)
segments(c(1, 2), 0, c(1, 2), 3, col = "gray50", lwd = 1.2) # Vertical panel dividers
segments(0, c(1, 2), 3, c(1, 2), col = "gray50", lwd = 1.2) # Horizontal panel dividers

# Color and Line Definitions
blue_col <- "#2B6CB0" # Level -1.0 (Solid line, circular points)
red_col  <- "#B83280" # Level  1.0 (Dashed line, square points)

# Helper function to map Y-data (80 to 95) to panel coordinate spaces
map_y <- function(val, panel_row) {
  # panel_row: 3 = top, 2 = middle, 1 = bottom
  y_bottom <- panel_row - 1
  return(y_bottom + (val - 80) / 15 * 0.82)
}

# 3. Draw Background Gridlines for Active Panels
x_ticks_rel <- c(0.25, 0.75)
y_ticks <- c(80, 85, 90, 95)

for (r in 1:3) {
  for (c in 1:3) {
    if (r != c) { # Skip diagonal panels
      # Vertical gridlines
      abline(v = (c - 1) + x_ticks_rel, col = "#EBF0F5", lwd = 1)
      # Horizontal gridlines
      for (y_val in y_ticks) {
        y_coord <- map_y(y_val, 4 - r)
        segments(c - 1, y_coord, c, y_coord, col = "#EBF0F5", lwd = 1)
      }
    }
  }
}

# 4. Draw Header Banners for Active Panels
headers <- list(
  list(r = 1, c = 2, txt = "B * A"), list(r = 1, c = 3, txt = "C * A"),
  list(r = 2, c = 1, txt = "A * B"), list(r = 2, c = 3, txt = "C * B"),
  list(r = 3, c = 1, txt = "A * C"), list(r = 3, c = 2, txt = "B * C")
)

for (h in headers) {
  y_top <- 4 - h$r
  rect(h$c - 1, y_top - 0.12, h$c, y_top, border = "gray50", col = "white", lwd = 0.8)
  text(x = h$c - 0.5, y = y_top - 0.06, labels = h$txt, cex = 2)
}

