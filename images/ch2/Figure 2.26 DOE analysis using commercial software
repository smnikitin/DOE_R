# Set inline display dimensions
options(repr.plot.width = 8, repr.plot.height = 6)

# Configure margins
par(mar = c(4.5, 4.5, 3.5, 2), xpd = TRUE, family = "sans")

# Data preparation (bottom to top)
terms <- c("AB", "BC", "AC", "A", "B", "C", "ABC")
effects <- c(0.5, 1.8, 3.0, 3.1, 6.3, 7.0, 7.6)

# Boundary coordinates for 7 contiguous bars (zero gap)
y_edges <- seq(0.3, 6.7, length.out = 8)

# 1. Initialize Canvas
plot(0, type = "n", xlim = c(0, 20.5), ylim = c(0.3, 7.1),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Draw Background Gridlines
abline(v = seq(0, 20, by = 5), col = "#E5E5E5", lwd = 1)

# 3. Draw Contiguous Bars (Minitab Blue)
for (i in 1:length(terms)) {
  rect(xleft = 0, 
       ybottom = y_edges[i], 
       xright = effects[i], 
       ytop = y_edges[i+1],
       col = "#82A6DB", border = "gray30", lwd = 1)
}

# 4. Red Dashed Reference Line and Value Annotation
ref_line_x <- 17.43
abline(v = ref_line_x, col = "red", lty = 2, lwd = 1.2)
text(x = ref_line_x, y = 7, labels = "17.43", col = "red", cex = 2, font = 2)

# 5. Plot Outer Border Box
rect(0, 0.3, 20.5, 6.7, border = "gray50", lwd = 1.2)

# 6. Axes and Labels
# X-Axis Ticks
axis(1, at = seq(0, 20, by = 5), pos = 0.3, col = NA, col.ticks = "gray50", 
     col.axis = "black", tck = -0.015, cex.axis = 2)
mtext("Effect", side = 1, line = 3, cex = 2, font = 1)

# Y-Axis Term Labels
y_mids <- (y_edges[-1] + y_edges[-length(y_edges)]) / 2
text(x = -0.6, y = y_mids, labels = terms, xpd = TRUE, adj = 1, font = 1, cex = 2)
text(x = -0.1, y = 7, labels = "Term", xpd = TRUE, adj = 1, font = 2, cex = 2)

# 7. Titles
mtext("Pareto Chart of the Effects", side = 3, line = 1.8, font = 2, cex = 2)

