# Set canvas display dimensions
options(repr.plot.width = 9, repr.plot.height = 7)

# Configure margins
par(mar = c(3, 3, 3, 2), family = "sans")

# 1. Data Points and Labels
x <- c(1, 1, 2, 3, 3, 4, 5.5, 7)
y <- c(74, 76, 92, 104, 106, 113, 116, 109)

# 2. Initialize Canvas (Domain: x in [0, 8], y in [50, 130])
plot(0, type = "n", xlim = c(0, 8), ylim = c(50, 130),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 3. Add Fine Background Dotted Grid
abline(h = seq(50, 130, by = 5), col = "#E5E7EB", lty = "dotted", lwd = 0.8)
abline(v = seq(0, 8, by = 0.5), col = "#E5E7EB", lty = "dotted", lwd = 0.8)

# 4. Draw Main Fitted Curves
x_seq <- seq(0.6, 7.2, length.out = 200)

# Red Curve (Quadratic Fit)
fit_quad <- lm(y ~ x + I(x^2))
y_red <- predict(fit_quad, newdata = data.frame(x = x_seq)) + 1.2
lines(x_seq, y_red, col = "#DC2626", lwd = 5)

# Green Curve (Smoothed Model Line)
fit_spline <- smooth.spline(x, y, df = 4)
y_green <- predict(fit_spline, x_seq)$y
lines(x_seq, y_green, col = "#16A34A", lwd = 2)

# 5. Steepest Ascent Path Vector (Blue Arrow)
arrows(-0.5, 52, 4.5, 128, col = "#2563EB", lwd = 2.5, length = 0.15)

# 6. Plot Data Points with Specific Markers
points(x[1:2], y[1:2], pch = 16, col = "black", cex = 2)         # x=1: Circles
points(x[3], y[3], pch = 16,, col = "black", cex = 2)             # x=2: Triangle Up
points(x[4:5], y[4:5], pch = 16, col = "black", cex = 2)         # x=3: Circles
points(x[6], y[6], pch = 16,, col = "black", cex = 2)             # x=4: Triangle Up
points(x[7], y[7], pch = 16,, col = "black", bg = "black", cex = 2)# x=5.5: Triangle Down
points(x[8], y[8], pch = 16,, col = "black", cex = 2)             # x=7: Diamond



# 9. Axes with Arrow Ends and Ticks
arrows(0, 50, 8, 50, length = 0.12, lwd = 2, xpd = TRUE)
arrows(0, 50, 0, 130, length = 0.12, lwd = 2, xpd = TRUE)

axis(1, at = 1:7, labels = FALSE, tck = -0.015, lwd = 1.5, pos = 50)
axis(2, at = seq(60, 120, by = 10), labels = FALSE, tck = -0.015, lwd = 1.5, pos = 0)
