# Set inline display dimensions
options(repr.plot.width = 10, repr.plot.height = 6)

# Configure margins
par(mar = c(4.5, 5.5, 4.5, 2), xpd = TRUE, family = "sans")

# 1. Initialize Canvas (X domain split into two halves: 0-2 for A, 2-4 for B)
plot(0, type = "n", xlim = c(0, 4), ylim = c(1.5, 8.2),
     xaxs = "i", yaxs = "i", axes = FALSE, xlab = "", ylab = "")

# 2. Draw Background Gridlines
abline(h = 2:8, col = "#E5E5E5", lwd = 1)
abline(v = c(0.5, 1.5, 2.5, 3.5), col = "#E5E5E5", lwd = 1)

# 3. Draw Center Reference Line (Grand Mean ~ 4.58)
abline(h = 4.58, col = "gray50", lty = 2, lwd = 1)

# 4. Outer Borders and Panel Dividers
rect(0, 1.5, 4, 8.6, border = "gray50", lwd = 1.2)        # Main outer boundary
segments(2, 1.5, 2, 8.6, col = "gray50", lwd = 1.2)       # Vertical panel divider
segments(0, 8.0, 4, 8.0, col = "gray50", lwd = 1.2)       # Horizontal header divider

# 5. Panel Headers
text(x = 1, y = 8.3, labels = "A", font = 1, cex = 2)
text(x = 3, y = 8.3, labels = "B", font = 1, cex = 2)

# 6. Plot Data Points and Lines (Dark Charcoal/Gray)
line_color <- "#555555"

# Factor A (Mapped to x = 0.5 and x = 1.5)
lines(c(0.5, 1.5), c(3.26, 5.92), col = line_color, lwd = 1.8)
points(c(0.5, 1.5), c(3.26, 5.92), pch = 16, col = line_color, cex = 2)

# Factor B (Mapped to x = 2.5 and x = 3.5)
lines(c(2.5, 3.5), c(1.81, 7.37), col = line_color, lwd = 1.8)
points(c(2.5, 3.5), c(1.81, 7.37), pch = 16, col = line_color, cex = 2)

# 7. Axes and Labels
# Y-axis (Attached exactly to left edge at x = 0)
axis(2, at = 2:8, pos = 0, las = 1, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015,cex.axis = 2)
mtext("Mean", side = 2, line = 3, cex = 2, font = 3)

# X-axis (Attached exactly to bottom edge at y = 1.5)
axis(1, at = c(0.5, 1.5), labels = c("-1", "1"), pos = 1.5, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015, cex.axis = 2)
axis(1, at = c(2.5, 3.5), labels = c("-1", "1"), pos = 1.5, col = NA, col.ticks = "gray50", col.axis = "black", tck = -0.015,cex.axis = 2)

# 8. Main Titles
mtext("Main Effects Plot", side = 3, line = 2.2, font = 2, cex = 2)
