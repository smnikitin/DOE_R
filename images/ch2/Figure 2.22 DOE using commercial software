# Set inline display dimensions
options(repr.plot.width = 11, repr.plot.height = 7)

# Configure margins (extra right margin for legends)
par(mar = c(5, 5, 5, 7), xpd = TRUE, family = "sans")

# 1. Initialize Canvas (Domain: X = [0, 4], Y = [0, 4])
plot(0, type = "n", xlim = c(0, 4), ylim = c(0, 4),
     xaxs = "i", yaxs = "i", axes = FALSE, xaxs = "i", yaxs = "i", xlab = "", ylab = "")

# 2. Outer Boundaries and 2x2 Grid Lines
rect(0, 0, 4, 4, border = "gray50", lwd = 1.2)
segments(2, 0, 2, 4, col = "gray50", lwd = 1.2) # Vertical divider
segments(0, 2, 4, 2, col = "gray50", lwd = 1.2) # Horizontal divider

# Custom Colors
gray_dark <- "#404040"
gray_light <- "#808080"

# --- TOP-RIGHT PANEL (B * A) ---
# Gridlines
abline(v = c(2.5, 3.5), col = "#E5E5E5", lwd = 1)
segments(2, c(2.4, 2.8, 3.2, 3.6), 4, c(2.4, 2.8, 3.2, 3.6), col = "#E5E5E5", lwd = 1)

# Header Banner
rect(2, 3.8, 4, 4, border = "gray50", lwd = 1)
text(x = 3, y = 3.9, labels = "B * A", cex = 2)

# Data Lines (Y mapped from range 2-10 to vertical space 2.0-3.8)
# A = 1.0 (Long dash, dark)
lines(c(2.5, 3.5), c(2.2, 3.6), col = gray_dark, lwd = 1.8, lty = 5)
points(c(2.5, 3.5), c(2.2, 3.6), pch = 16, col = gray_dark, cex = 2)

# A = -1.0 (Dotted, light)
lines(c(2.5, 3.5), c(2.05, 2.8), col = gray_light, lwd = 1.8, lty = 3)
points(c(2.5, 3.5), c(2.05, 2.8), pch = 15, col = gray_light, cex = 2)

