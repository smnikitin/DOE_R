abline(v = c(0.5, 1.5), col = "#E5E5E5", lwd = 1)
segments(0, c(0.4, 0.8, 1.2, 1.6), 2, c(0.4, 0.8, 1.2, 1.6), col = "#E5E5E5", lwd = 1)

# Header Banner
rect(0, 1.8, 2, 2, border = "gray50", lwd = 1)
