# Right Y-Axis (2, 4, 6, 8, 10)
axis(4, at = c(2.0, 2.45, 2.9, 3.35, 3.8), labels = c("2", "4", "6", "8", "10"), pos = 4, las = 1, col = NA, col.ticks = "gray50", tck = -0.015, cex.axis = 2)


# --- BOTTOM-LEFT PANEL (B * B) ---
