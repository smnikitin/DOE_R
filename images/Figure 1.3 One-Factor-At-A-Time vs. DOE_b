# Row Indices (1 - 9)
text(x = 0.25, y = seq(8.5, 0.5, by = -1), labels = 1:9, col = "black", font = 2, cex = 2)

# 6. Insert Data
d1 <- c(-1, 1, -1, 1, -1, 1, -1, 1)
d2 <- c(-1, -1, 1, 1, -1, -1, 1, 1)
d3 <- c(-1, -1, -1, -1, 1, 1, 1, 1)
d4 <- c(1, -1, -1, 1, 1, -1, -1, 1)
d5 <- c(1, -1, 1, -1, -1, 1, -1, 1)
d6 <- c(1, 1, -1, -1, -1, -1, 1, 1)
d7 <- c(-1, 1, 1, -1, 1, -1, -1, 1)
d8 <- c(49.9, 44.3, 44.9, 78.9, 50.5, 45.3, 44.7, 81.5)

data_cols <- list(d1, d2, d3, d4, d5, d6, d7, d8)

for (col_idx in 1:8) {
  d <- data_cols[[col_idx]]
  
  # Format column C12 with a single decimal place like the image
  if (col_idx == 8) {
    labels_str <- sprintf("%.1f", d)
  } else {
    labels_str <- as.character(d)
  }
  
  # Place text (adj = 1 right-aligns the text)
  # X is positioned slightly left of the right gridline to give spreadsheet padding
  text(x = col_idx + 0.35, y = seq(8.5, 1.5, by = -1),
       labels = labels_str, adj = 1, cex = 2, col = "gray20")
}

