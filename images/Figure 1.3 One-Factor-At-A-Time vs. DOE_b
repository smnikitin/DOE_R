# 1. Define the experimental data
levels <- c(-1, 1)
effect_a_y <- c(85.1, 81.6)
effect_b_y <- c(82.6, 83.8)

# Define center points (Level 0.0)
center_pt_x <- 0
center_pt_y <- 92 

# 2. Configure the plotting layout and TEXT SIZES
# Set up 1 row and 2 columns, with outer margins for the main bounding box
par(mfrow = c(1, 2), 
    oma = c(2, 2, 2, 2),  # Outer margins
    mar = c(4, 4, 3, 1),  # Inner margins per plot
    xpd = NA,             # Disable clipping to allow the red box to span across panels
    
    # --- TEXT AND NUMBER SCALING ---
    cex.axis = 2,       # Increases the size of the axis numbers by 20%
    cex.main = 2,       # Increases the size of the main titles ("Effect: A") by 50%
    cex.lab  = 2)       # Increases axis labels (if added later) by 20%

# 3. Plot for Effect A (Left Panel)
plot(levels, effect_a_y, 
     type = "o", pch = 19, 
     xlim = c(-1.2, 1.2), ylim = c(78, 95),
     xlab = "", ylab = "", main = "Effect: A")
points(center_pt_x, center_pt_y, pch = 19)

# 4. Plot for Effect B (Right Panel)
plot(levels, effect_b_y, 
     type = "o", pch = 19, 
     xlim = c(-1.2, 1.2), ylim = c(78, 95),
     xlab = "", ylab = "", main = "Effect: B")
points(center_pt_x, center_pt_y, pch = 19)

# 5. Add Overlays
# Draw the overall outer bounding box encompassing both plots
box("outer", col = "black")

# Draw the red box highlighting the center points.
rect(xleft = -4.2, ybottom = 91, 
     xright = 0.5, ytop = 93, 
     border = "red", lwd = 1.5)

# Set inline display size for Google Colab
options(repr.plot.width = 6, repr.plot.height = 6)

# Set margins and graphics parameters
par(
  family = "sans",
  mar = c(3.5, 3.5, 3, 1),
  mgp = c(2, 0.7, 0),
  cex.axis = 2,
  xaxs = "i", yaxs = "i"
)

# Create grid coordinates
n <- 400
x <- seq(-1, 1, length.out = n)
y <- seq(-1, 1, length.out = n)

# Create meshgrid matrices
X <- matrix(x, nrow = n, ncol = n)
Y <- matrix(y, nrow = n, ncol = n, byrow = TRUE)

# Response surface function generating the contour shapes
Z <- -1.2 * X + 0.5 * Y + 1.0 * X^2 + 1.2 * Y^2 + 1.8 * X * Y

# Green color palette matching the 5 discrete shaded regions
green_pal <- c("#AEE6B3", "#78CB78", "#45A845", "#0F7A0F", "#004D00")
breaks <- c(-2.0, -0.5, 0.8, 2.2, 3.0, 5.0)

# Render filled contour regions
image(x, y, Z, col = green_pal, breaks = breaks, axes = FALSE, xlab = "", ylab = "")

# Add top title
mtext("Contour Plot of C7 vs B, A", side = 3, line = 1, font = 2, cex = 2, col = "gray25")

# Draw custom axes with outward tick marks
axis(1, at = seq(-1, 1, by = 0.5), labels = c("-1.0", "-0.5", "0.0", "0.5", "1.0"), tck = -0.015)
axis(2, at = seq(-1, 1, by = 0.5), labels = c("-1.0", "-0.5", "0.0", "0.5", "1.0"), las = 1, tck = -0.015)

