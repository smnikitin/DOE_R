# Data points for the main effect plot
fov <- c(-1.0, 1.0)
comfort <- c(3.25, 5.90)

# Figure size (matches the aspect ratio of your image)
options(repr.plot.width = 7.5, repr.plot.height = 7.5)
par(
  family = "serif",
  mar = c(5.5, 5.8, 4, 0.8),
  mgp = c(3.0, 1.0, 0),
  cex.lab = 2,
  cex.axis = 1.5,
  cex.main = 2.1
)

# Create the empty plot canvas with exact limits
plot(NA, 
     xlim = c(-1.1, 1.1), ylim = c(1, 10),
     xaxs = "i", yaxs = "i",
     xlab = "FOV", ylab = "Mean User Comfort",
     main = "Main Effect of FOV on User Comfort",
     axes = FALSE)

# Draw background grid lines (matching Python/Matplotlib style)
abline(h = seq(1, 10, by = 1), col = "gray90", lwd = 1)
abline(v = seq(-1.0, 1.0, by = 0.25), col = "gray90", lwd = 1)

# Draw the connecting line using Matplotlib's default blue color
lines(fov, comfort, col = "gray20", lwd = 2)

# Draw solid circular data points at the factor levels
points(fov, comfort, pch = 19, col = "gray10", cex = 1.5)

# Draw custom axes with two decimal places on the X-axis
axis(1, at = seq(-1.0, 1.0, by = 0.5), labels = sprintf("%.1f", seq(-1.0, 1.0, by = 0.5)), tck = 0)
axis(2, at = seq(1, 10, by = 1), las = 1, tck = 0)

# Draw the outer frame box
box(lwd = 1, col = "gray10")

