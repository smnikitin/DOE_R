# Load the Experimental Data
data <- data.frame(
  x1 = c(90, 140, 90, 140),
  x2 = c(150, 150, 185, 185),
  Response = c(220, 83, 275, 435)
)

#  Add Coded Units (A, B) alongside Real Units (x1, x2)
data$A <- (data$x1 - mean(range(data$x1))) / (diff(range(data$x1)) / 2)
data$B <- (data$x2 - mean(range(data$x2))) / (diff(range(data$x2)) / 2)

# Fit TWO Models to demonstrate their distinct purposes
print(data)
model_real  <- lm(Response ~ x1 + x2 + x1:x2, data = data)
model_coded <- lm(Response ~ A + B + A:B, data = data)

#  Equation Generation 
IRdisplay::display_markdown(paste0("$$Y = ", sub("^\\+", "", paste(sprintf("%+.2f %s", coef(model_real), c("", gsub(":", " \\\\cdot ", gsub("I\\((.*?)\\)", "\\1", names(coef(model_real))[-1])))), collapse = " ")), "$$"))
IRdisplay::display_markdown(paste0("$$Y = ", sub("^\\+", "", paste(sprintf("%+.2f %s", coef(model_coded), c("", gsub(":", " \\\\cdot ", gsub("I\\((.*?)\\)", "\\1", names(coef(model_coded))[-1])))), collapse = " ")), "$$"))


